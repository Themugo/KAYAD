# KAYAD backend environment contract.
# Values are intentionally non-secret placeholders; production secrets are
# configured by the deployment environment, not committed to source.
# Grouping mirrors backend/utils/env.js (ALWAYS_REQUIRED_VARS,
# PRODUCTION_REQUIRED_VARS, FEATURE_GROUPS).

# ─── Core ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# ─── Required in production (server.js CORS/callback/email-link contract) ──
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
REFRESH_TOKEN_SECRET=
SESSION_SECRET=

# ─── Token lifetimes ─────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=30d
ACCESS_COOKIE_MS=900000

# ─── M-Pesa (Safaricom Daraja) ───────────────────────────────────
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_WEBHOOK_SECRET=
KAYAD_MASTER_PAYBILL=
KAYAD_AUCTION_COMMITMENT_PAYBILL=

# ─── M-Pesa B2C (refunds / winner payouts) ───────────────────────
MPESA_B2C_INITIATOR=
MPESA_B2C_INITIATOR_PW=
MPESA_B2C_SHORTCODE=
MPESA_B2C_CALLBACK_URL=
MPESA_B2C_TIMEOUT_URL=
MPESA_B2C_REMARKS=
MPESA_B2C_OCCASION=

# ─── Escrow ───────────────────────────────────────────────────────
# Escrow account identity is deployment-configured, not hardcoded.
ESCROW_ACCOUNT_NUMBER=
ESCROW_AUTO_RELEASE_DAYS=14
ESCROW_CRON_ENABLED=true

# ─── Cloudinary (image hosting) ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Africa's Talking (SMS/OTP) ───────────────────────────────────
AT_API_KEY=
AT_USERNAME=

# ─── Twilio (WhatsApp) ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ─── Brevo (transactional email) ──────────────────────────────────
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=KAYAD

# ─── Redis (caching / queues) ─────────────────────────────────────
REDIS_URL=
DISABLE_REDIS=false

# ─── Observability ────────────────────────────────────────────────
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=
LOG_LEVEL=info

# ─── Admin / seed (non-production use only) ───────────────────────
SEED_PROVISIONING_ENABLED=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
