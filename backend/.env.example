# KAYAD backend production environment contract.
# NEVER commit real credentials. Set these in the hosting provider.
NODE_ENV=production
PORT=5000
SUPABASE_URL=https://<project-ref>.supabase.co
# Canonical name. SUPABASE_SERVICE_KEY remains accepted as a legacy alias.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
JWT_SECRET=<32+-character-random-secret>
REFRESH_TOKEN_SECRET=<different-32+-character-random-secret>
SESSION_SECRET=<different-32+-character-random-secret>
FRONTEND_URL=https://kayad.space
BACKEND_URL=https://api.kayad.space
MPESA_CONSUMER_KEY=<daraja-consumer-key>
MPESA_CONSUMER_SECRET=<daraja-consumer-secret>
MPESA_SHORTCODE=<paybill-or-till>
MPESA_PASSKEY=<lipa-na-mpesa-passkey>
MPESA_CALLBACK_URL=https://api.kayad.space/api/payments/callback
MPESA_ENV=production
AT_API_KEY=<africas-talking-api-key>
AT_USERNAME=<africas-talking-username>
RESEND_API_KEY=<resend-api-key>
RESEND_FROM_EMAIL=KAYAD <noreply@kayad.space>
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_WHATSAPP_NUMBER=whatsapp:+254...
