# KAYAD backend production environment contract.
# NEVER commit real credentials. Set these in the hosting provider.
NODE_ENV=production
PORT=5000
SUPABASE_URL=https://<project-ref>.supabase.co
# Canonical name. SUPABASE_SERVICE_KEY remains accepted as a legacy alias.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
JWT_SECRET=<32+-character-random-secret>
REFRESH_TOKEN_SECRET=<different-32+-character-random-secret>
SESSION_SECRET=<different-32+-character-random-secret>
FRONTEND_URL=https://kayad.space
BACKEND_URL=https://api.kayad.space
# Optional integrations for later payment/OTP activation. Leave unset until the
# corresponding feature is being activated. Set REQUIRE_MPESA=true or
# REQUIRE_SMS=true only when the complete credential set is available.
MPESA_CONSUMER_KEY=<daraja-consumer-key>
MPESA_CONSUMER_SECRET=<daraja-consumer-secret>
MPESA_SHORTCODE=<paybill-or-till>
MPESA_PASSKEY=<lipa-na-mpesa-passkey>
MPESA_CALLBACK_URL=https://api.kayad.space/api/payments/callback
MPESA_ENV=production
REQUIRE_MPESA=false
AT_API_KEY=<africas-talking-api-key>
AT_USERNAME=<africas-talking-username>
REQUIRE_SMS=false
BREVO_API_KEY=<brevo-api-key>
BREVO_FROM_EMAIL=no-reply@kayad.space
BREVO_FROM_NAME=KAYAD
BREVO_WEBHOOK_TOKEN=<brevo-webhook-bearer-token>
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_WHATSAPP_NUMBER=whatsapp:+254...
REQUIRE_WHATSAPP=false
# Optional approved WhatsApp Content Template for production-initiated messages
TWILIO_WHATSAPP_CONTENT_SID=<twilio-content-template-sid>
TWILIO_WHATSAPP_CONTENT_VARIABLES={"1":"KAYAD"}
TWILIO_STATUS_CALLBACK_URL=https://api.kayad.space/api/communications/webhooks/twilio/status
COMMUNICATION_WEBHOOK_SECRET=<shared-webhook-secret>
REDIS_URL=<render-managed-redis-url>
