{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "lib",
    "e2e",
    "src/components/Breadcrumbs.tsx",
    "src/components/ErrorBoundary.tsx",
    "src/components/ProductVariantSelector.tsx",
    "src/components/ThemeApplier.tsx",
    "src/components/comparison/ComparisonBar.tsx",
    "src/components/comparison/ProductComparison.tsx",
    "src/components/customer/CustomerPaymentMethods.tsx",
    "src/components/dashboard/ExecutiveDashboard.tsx",
    "src/components/layout/CustomerLayout.tsx",
    "src/components/layout/Header.tsx",
    "src/components/leads/LeadForm.tsx",
    "src/components/leads/LeadList.tsx",
    "src/components/product/ProductSpecifications.tsx",
    "src/components/product/StickyPurchasePanel.tsx",
    "src/components/search/AdvancedSearch.tsx",
    "src/components/ui/OptimizedImage.tsx",
    "src/components/ui/WhatsAppButton.tsx",
    "src/components/ui/accordion.tsx",
    "src/components/ui/alert-dialog.tsx",
    "src/components/ui/breadcrumb.tsx",
    "src/components/ui/button-group.tsx",
    "src/components/ui/checkbox.tsx",
    "src/components/ui/collapsible.tsx",
    "src/components/ui/context-menu.tsx",
    "src/components/ui/dialog.tsx",
    "src/components/ui/dropdown-menu.tsx",
    "src/components/ui/empty.tsx",
    "src/components/ui/field.tsx",
    "src/components/ui/hover-card.tsx",
    "src/components/ui/image-upload.tsx",
    "src/components/ui/input-group.tsx",
    "src/components/ui/item.tsx",
    "src/components/ui/kbd.tsx",
    "src/components/ui/label.tsx",
    "src/components/ui/menubar.tsx",
    "src/components/ui/navigation-menu.tsx",
    "src/components/ui/pagination.tsx",
    "src/components/ui/popover.tsx",
    "src/components/ui/scroll-area.tsx",
    "src/components/ui/select.tsx",
    "src/components/ui/separator.tsx",
    "src/components/ui/sheet.tsx",
    "src/components/ui/sidebar.tsx",
    "src/components/ui/spinner.tsx",
    "src/components/ui/switch.tsx",
    "src/components/ui/textarea.tsx",
    "src/components/ui/toast.tsx",
    "src/components/ui/toggle-group.tsx",
    "src/components/ui/toggle.tsx",
    "src/context/CMSContext.tsx"
  ]
}
