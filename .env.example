# KAYAD frontend build-time contract.
# Values are intentionally non-secret placeholders; production secrets are
# configured by the deployment environment, not committed to source.
# See .env.production.example for the production reference values.
VITE_API_URL=/api
VITE_SOCKET_URL=https://api.kayad.space
VITE_PUBLIC_URL=https://www.kayad.space

# --- Support & Resolution Center ---
# Response/resolution targets are shown to customers and used in staff metrics ONLY when set.
# Leave unset to make no timing promise (recommended until operations has staffed coverage).
# SUPPORT_SLA_FIRST_RESPONSE_MINUTES=
# SUPPORT_SLA_RESOLUTION_MINUTES=
# Days after resolution during which a customer reply reopens the case (default 14; business decision).
# SUPPORT_REOPEN_WINDOW_DAYS=14
