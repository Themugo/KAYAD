# KAYAD frontend environment template
# Copy the values appropriate for the environment into your local/deployment settings.
# Never commit real credentials or secret keys.

# API used by the browser. Local development normally uses the Vite proxy.
VITE_API_URL=/api

# Supabase project used by KAYAD Realtime. These are public client settings,
# not the service-role key. Keep the service-role key server-side only.
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Optional frontend observability.
VITE_SENTRY_DSN=
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
