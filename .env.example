# KAYAD frontend build-time contract.
# Values are intentionally non-secret placeholders; production secrets are
# configured by the deployment environment, not committed to source.
# See .env.production.example for the production reference values.
VITE_API_URL=/api
VITE_SOCKET_URL=https://api.kayad.space
VITE_PUBLIC_URL=https://www.kayad.space
