# KAYAD frontend environment variables (Vite)
# Copy this file to .env.local and fill in real values.
# Only variables prefixed with VITE_ are exposed to client-side code.

# Base URL of the backend API this frontend talks to.
VITE_API_URL="http://localhost:5050"

# Base URL of the backend's Socket.IO / realtime server.
VITE_SOCKET_URL="http://localhost:5050"

# Supabase project URL and publishable (anon) key.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# PostHog analytics (optional — leave unset to disable analytics).
VITE_POSTHOG_API_KEY=""
VITE_POSTHOG_HOST=""

# Set to "true" to enable demo/mock-data mode.
VITE_ENABLE_DEMO="false"
