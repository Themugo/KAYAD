+check('race: exactly one side wins each round', wonSale + wonEscrow === 12, { wonSale, wonEscrow }); console.log('  race tally', { wonSale, wonEscrow });
+let bad2 = 0;
+for (let i = 0; i < 8; i++) {
+  const rc = car(A, 'RaceS' + i);
