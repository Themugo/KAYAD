+// ---- pause / publish -----------------------------------------------------------------------------------------------------------
+const p1 = car(A, 'Pausable');
+check('pause then publish round-trip', (await bulk(A, [p1], 'hidden')).status === 200 && row(p1).startsWith('hidden') && (await bulk(A, [p1], 'available')).status === 200 && row(p1).startsWith('available'));
