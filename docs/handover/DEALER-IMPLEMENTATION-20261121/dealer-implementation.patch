+// ---- DA-02 bulk: one canonical lifecycle, itemised, mixed and duplicate selections ---------------------------------------------
+const b1 = car(A, 'Bulk1'), b2 = car(A, 'Bulk2'), b3 = car(A, 'Bulk3');
